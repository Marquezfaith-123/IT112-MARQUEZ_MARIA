#include <stdio.h>

int main() {
    int choice;
    float balance = 500.00;
    float amount;

    do {
        printf("\n==============================\n");
        printf("        BSIT BANK ATM\n");
        printf("==============================\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("==============================\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("\nYour current balance is: P%.2f\n", balance);
                break;

            case 2:
                printf("\nEnter amount to deposit: P");
                scanf("%f", &amount);

                if (amount > 0) {
                    balance = balance + amount;
                    printf("Deposit successful!\n");
                    printf("New balance: P%.2f\n", balance);
                } else {
                    printf("Invalid deposit amount!\n");
                }
                break;

            case 3:
                printf("\nEnter amount to withdraw: P");
                scanf("%f", &amount);

                if (amount <= 0) {
                    printf("Invalid withdrawal amount!\n");
                } else if (balance - amount < 100.00) {
                    printf("Withdrawal denied! You must maintain at least P100.00 in your account\n");
                } else {
                    balance = balance - amount;
                    printf("Withdrawal successful!\n");
                    printf("Remaining balance: P%.2f\n", balance);
                }
                break;

            case 4:
                printf("\nThank you for using BSIT BANK ATM!\n");
                printf("Please come again!\n");
                break;

            default:
                printf("\nInvalid choice! Please select 1-4.\n");
        }

    } while (choice != 4);

    return 0;
}
