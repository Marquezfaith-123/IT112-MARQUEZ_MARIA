#include <stdio.h>

int main() {
    int number;
    int sum = 0;

    printf("Enter numbers one by one.\n");
    printf("Enter 0 or a negative number to stop.\n\n");

    while (1) {
        printf("Enter a number: ");
        scanf("%d", &number);

        if (number > 0) {
            sum = sum + number;
        } else {
            break;
        }
    }

    printf("\nTotal sum of positive numbers: %d\n", sum);

    return 0;
}